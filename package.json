{
  "name": "eklipse-ro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \".github/*.md\" \".github/skills/**/*.md\"",
    "lint:dead-code": "fallow dead-code --type-aware",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "tsx scripts/run-browser-tests.ts",
    "ci": "npm run typecheck && npm run lint:markdown && npm run lint:dead-code && npm run test:coverage && npm run test:browser"
  },
  "dependencies": {
    "daisyui": "5.7.16",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "fallow": "3.14.0",
    "jsdom": "30.0.1",
    "markdownlint-cli2": "0.23.2",
    "nyc": "18.0.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
