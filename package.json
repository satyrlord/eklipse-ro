{
  "name": "eklipse-ro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \".github/*.md\" \".github/skills/**/*.md\"",
    "lint:dead-code": "fallow dead-code --type-aware",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "tsx scripts/run-browser-tests.ts",
    "ci": "npm run typecheck && npm run lint:markdown && npm run lint:dead-code && npm run test:coverage && npm run test:browser"
  },
  "dependencies": {
    "daisyui": "5.7.20",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "fallow": "3.34.0",
    "jsdom": "30.0.1",
    "markdownlint-cli2": "0.23.3",
    "nyc": "18.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "markdownlint-cli2": {
      "markdown-it": "15.0.3",
      "smol-toml": "1.9.1"
    },
    "micromark-extension-math@3.1.0": {
      "katex": "0.18.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
